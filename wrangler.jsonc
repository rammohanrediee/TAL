{
  "name": "tal-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "JWT_SECRET_KEY",
      "R2_ACCOUNT_ID",
      "R2_ACCESS_KEY_ID",
      "R2_SECRET_ACCESS_KEY",
      "R2_BUCKET_NAME",
      "R2_ENDPOINT_URL",
      "OAUTH_STATE_SECRET"
    ]
  },
  "containers": [
    {
      "class_name": "TalContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TAL_CONTAINER",
        "class_name": "TalContainer"
      }
    ]
  },
  "exports": {
    "TalContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}

APP_NAME=TAL
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://tal:tal@localhost:5432/tal
DATABASE_URL_UNPOOLED=postgresql+asyncpg://tal:tal@localhost:5432/tal
# .env is local and overrides Neon values in .env.local.
# Use scripts/configure_local_env.py for a native PostgreSQL server.
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value
OAUTH_STATE_SECRET=replace-with-another-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000/
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/backend/api/v1/auth/google/callback
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-r2-bucket-name
R2_ENDPOINT_URL=https://replace-with-r2-endpoint
OPENAI_API_KEY=replace-with-your-openai-api-key
EVIDENCE_PROVIDER=ollama
EVIDENCE_MODEL=replace-with-your-local-model
OLLAMA_BASE_URL=http://localhost:11434/v1

# For Neon AI Gateway, set EVIDENCE_PROVIDER=neon. Neon deploy supplies:
# NEON_AI_GATEWAY_BASE_URL and NEON_AI_GATEWAY_TOKEN in .env.local.
